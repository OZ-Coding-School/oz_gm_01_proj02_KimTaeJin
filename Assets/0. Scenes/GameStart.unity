  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uAE30\uBCF8\uC801\uC73C\uB85C \uBC40\uD30C\uC774\uC5B4 \uC11C\uBC14\uC774\uBC8C\uACFC
    \uD0C0\uC6CC\uB514\uD39C\uC2A4\uAC00\uC11E\uC778 \uC7A5\uB974\uC785\uB2C8\uB2E4.\n\nWASD/Enter
    \uB9CC \uC0AC\uC6A9\uD558\uC154\uB3C4 \uD50C\uB808\uC774\uC5D4 \uC9C0\uC7A5\uC774
    \uC5C6\uC73C\uBA70 \n\uB9C8\uC6B0\uC2A4 \uC0AC\uC6A9\uB3C4 \uAC00\uB2A5\uD569\uB2C8\uB2E4.\n\n\uC790\uC6D0\uC744
    \uCE90\uACE0, \uC131\uC5D0 \uB0A9\uBD80\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uB0A9\uBD80\uB41C
    \uC790\uC6D0\uC740 \uACBD\uD5D8\uCE58\uB85C \uD658\uC804\uB418\uBA70, \uB808\uBCA8\uC5C5\uC774
    \uAC00\uB2A5\uD574\uC9C0\uACE0\n\n\uD50C\uB808\uC774\uC5B4\uB294 \uB808\uBCA8\uC5C5\uB9C8\uB2E4
    \uB79C\uB364\uD55C \uC120\uD0DD\uC9C0\uB97C \uD1B5\uD574 \uD0C0\uC6CC\uB97C \uC124\uCE58\uD558\uB294\uAC8C
    \uAC00\uB2A5\uD569\uB2C8\uB2E4.\n\n\uB610\uD55C \uC790\uC6D0\uBCC4 \uBCC4\uB3C4\uC758
    \uB808\uBCA8\uB9C1 \uC2DC\uC2A4\uD15C\uC774 \uC788\uC2B5\uB2C8\uB2E4\n\uB098\uBB34
    : \uD3EC\uD0D1\uC758 \uACF5\uACA9\uC18D\uB3C4 \uC99D\uAC00\n\uB3CC : \uC911\uC2EC\uAC74\uBB3C\uC758
    \uC5EC\uBD84 HP \n\n\uD50C\uB808\uC774\uC5B4 \uBCF8\uC778\uB3C4 \uAC15\uD654\uB97C
    \uD560 \uC218\uC788\uC73C\uBA70 \uBAA9\uD45C\uC9C0\uC810\uAE4C\uC9C0 \uB3C4\uCC29\uD558\uB294\uAC8C\n\uAC8C\uC784\uC758
    \uBAA9\uD45C\uC785\uB2C8\uB2E4."
